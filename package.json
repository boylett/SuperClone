{
  "name": "superclone",
  "displayName": "SuperClone",
  "description": "Clone all branches of a git repository into individual folders and open them as a workspace.",
  "version": "0.0.5",
  "publisher": "boylett",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/boylett/SuperClone.git"
  },
  "bugs": {
    "url": "https://github.com/boylett/SuperClone/issues"
  },
  "homepage": "https://github.com/boylett/SuperClone#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Spawns the local `git` binary to fetch branches into folders on disk."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "clone",
    "branches",
    "workspace",
    "multi-root"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "superclone.superClone",
        "title": "Git: Super Clone"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "package": "mkdir -p releases && vsce package --out releases",
    "release": "npm run typecheck && mkdir -p releases && vsce package --out releases"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}