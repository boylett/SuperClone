{
  "name": "superclone",
  "displayName": "SuperClone",
  "description": "Clone all branches of a git repository into individual folders and open them as a workspace.",
  "publisher": "boylett",
  "icon": "icon.png",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/boylett/SuperClone"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "superclone.superClone",
        "title": "Git: Super Clone"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src",
    "package": "vsce package",
    "build": "node scripts/build-vsix.js",
    "publish": "vsce publish",
    "release": "vsce publish --no-git-tag-version"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.3.0"
  }
}